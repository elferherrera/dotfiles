layout {
    cwd "/Users/fernando.elizalde/Documents/projects/devops/cicd"
    tab name="running" hide_floating_panes=true {
        pane command="/Users/fernando.elizalde/bin/poetry/bin/poetry" cwd="alert-courier" {
            args "shell"
            start_suspended false
        }
    }
    tab name="alert-courier" focus=true hide_floating_panes=true {
        pane command="/Users/fernando.elizalde/bin/poetry/bin/poetry" cwd="alert-courier" {
            args "shell"
            start_suspended false
        }
    }
    tab name="server" hide_floating_panes=true {
        pane split_direction="horizontal" {
            pane cwd="alert-courier" size="70%"
            pane {
                cwd "alert-courier"
                size "30%"
                command "/Users/fernando.elizalde/bin/poetry/bin/poetry"
                args "shell"
            }
        }
    }
    tab name="databases" hide_floating_panes=true {
        pane split_direction="horizontal" {
            pane name="postgres" cwd="alert-courier" size="50%"
            pane split_direction="vertical" {
                pane name="redis" cwd="alert-courier" size="50%"
                pane name="docker" cwd="alert-courier" size="50%"
            }
        }
    }
    default_tab_template {
        // the default zellij tab-bar and status bar plugins
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
}

