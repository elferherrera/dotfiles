layout {
    cwd "/Users/fernando.elizalde/Documents/projects/devops/cicd/dsl/infra-dsl-transpiler/"
    tab name="running" hide_floating_panes=true {
        pane command="/Users/fernando.elizalde/bin/poetry/bin/poetry" cwd="dsl_transpiler" {
            args "shell"
            start_suspended false
        }
    }
    tab name="transpiler" focus=true hide_floating_panes=true {
        pane command="/Users/fernando.elizalde/bin/poetry/bin/poetry" cwd="dsl_transpiler" {
            args "shell"
            start_suspended false
        }
    }
    tab name="dsl" hide_floating_panes=true {
        pane cwd="/Users/fernando.elizalde/Documents/projects/devops/cicd/dsl/infra-dsl" {
        }
    }
    tab name="apps" hide_floating_panes=true {
        pane cwd="/Users/fernando.elizalde/Documents/projects/devops/cicd/dsl/infra-apps" {
        }
    }
    tab name="export" hide_floating_panes=true {
        pane cwd="/Users/fernando.elizalde/Documents/projects/devops/cicd/dsl/technology-governance-export" {
        }
    }
    default_tab_template {
        // the default zellij tab-bar and status bar plugins
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
}
