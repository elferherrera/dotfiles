layout {
    cwd "/Users/fernando.elizalde/Documents/projects/devops/cicd/devops-internal"
    tab name="running" hide_floating_panes=true {
        pane command="/Users/fernando.elizalde/bin/poetry/bin/poetry" cwd="atlantis-coordinator" {
            args "shell"
            start_suspended false
        }
    }
    tab name="atlantis" focus=true hide_floating_panes=true {
        pane command="/Users/fernando.elizalde/bin/poetry/bin/poetry" cwd="atlantis-coordinator" {
            args "shell"
            start_suspended false
        }
    }
    default_tab_template {
        // the default zellij tab-bar and status bar plugins
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
}
